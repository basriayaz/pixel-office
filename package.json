{
  "name": "pixel-office",
  "version": "0.1.0",
  "description": "A pixel-art office for your Claude agents: hire AI employees, give them jobs, teach them things they never forget.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pixel-office": "bin/pixel-office.js"
  },
  "files": [
    "bin",
    "dist",
    "web",
    "locales",
    "templates",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node bin/pixel-office.js",
    "dev": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.272",
    "express": "^5.1.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "author": "Basri Ayaz (https://github.com/basriayaz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basriayaz/pixel-office.git"
  },
  "homepage": "https://github.com/basriayaz/pixel-office#readme",
  "bugs": {
    "url": "https://github.com/basriayaz/pixel-office/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent-sdk",
    "ai-agents",
    "pixel-art",
    "virtual-office",
    "anthropic"
  ]
}
